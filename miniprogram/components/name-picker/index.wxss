/* 名称选择弹窗：头像 + 名字，一排 5 个 */

.np-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 120;
  display: flex;
  align-items: flex-end;
  background: rgba(0, 0, 0, 0.66);
}

.np-modal {
  width: 100%;
  max-height: 82vh;
  display: flex;
  flex-direction: column;
  background: #10141f;
  border-radius: 28rpx 28rpx 0 0;
  border-top: 1rpx solid rgba(211, 188, 142, 0.32);
  padding-bottom: env(safe-area-inset-bottom);
}

.np-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 28rpx 16rpx;
}

.np-title {
  font-size: 32rpx;
  font-weight: 600;
}

.np-close {
  width: 56rpx;
  height: 56rpx;
  line-height: 52rpx;
  text-align: center;
  font-size: 40rpx;
  color: #8b90a6;
}

.np-tabs {
  display: flex;
  padding: 0 28rpx 12rpx;
}

.np-tab {
  margin-right: 12rpx;
  padding: 10rpx 22rpx;
  border-radius: 14rpx;
  border: 1rpx solid transparent;
  background: rgba(9, 11, 20, 0.55);
  color: #8b90a6;
  font-size: 24rpx;
  line-height: 1.3;
}

.np-tab.active {
  border-color: rgba(211, 188, 142, 0.34);
  background: rgba(211, 188, 142, 0.16);
  color: #f2e2bd;
  font-weight: 600;
}

.np-count {
  margin-left: 8rpx;
  font-size: 20rpx;
  opacity: 0.7;
}

.np-body {
  flex: 1;
  height: 60vh;
  box-sizing: border-box;
  padding: 0 28rpx 24rpx;
}

.np-grid {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -6rpx;
}

.np-cell {
  width: calc(20% - 12rpx);
  margin: 6rpx;
  padding: 14rpx 4rpx 10rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  border-radius: 16rpx;
  border: 1rpx solid transparent;
  background: rgba(9, 11, 20, 0.5);
}

.np-cell.active {
  border-color: rgba(211, 188, 142, 0.6);
  background: rgba(211, 188, 142, 0.13);
}

.np-cell:active {
  background: rgba(211, 188, 142, 0.1);
}

.np-icon {
  position: relative;
  width: 96rpx;
  height: 96rpx;
  border-radius: 16rpx;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
  color: #f2e2bd;
  background: rgba(211, 188, 142, 0.12);
  border: 1rpx solid rgba(211, 188, 142, 0.24);
}

.np-icon image {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.np-name {
  width: 100%;
  margin-top: 8rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  text-align: center;
  font-size: 20rpx;
  color: #ecebe7;
}

.np-empty {
  padding: 40rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: #8b90a6;
}

.login-page {
  padding-top: 0;
}

.login-hero {
  text-align: center;
  padding-bottom: 48rpx;
}

.login-mark {
  width: 112rpx;
  height: 112rpx;
  line-height: 112rpx;
  font-size: 40rpx;
  margin: 0 auto 24rpx;
  border-radius: 24rpx;
}

.login-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #f2e2bd;
}

.login-sub {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #8b90a6;
}

.login-actions {
  display: flex;
  margin-top: 28rpx;
}

.login-btn {
  flex: 1;
  padding: 22rpx 0;
  margin-right: 20rpx;
}

.login-btn:last-child {
  margin-right: 0;
}

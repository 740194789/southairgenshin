/* SouthAir Genshin · 离线小程序全局样式（桑多涅主题：瓷白 / 银灰 / 猩红） */

page {
  background: #07080d;
  color: #ecebe7;
  font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
}

.page {
  position: relative;
  z-index: 0;
  padding: 24rpx;
  padding-bottom: 40rpx;
}

/* 桑多涅立绘背景 + 暗色遮罩（各页面顶部各放一份） */
.sandrone-bg {
  position: fixed;
  left: 0;
  top: 0;
  width: 100vw;
  height: 100vh;
  z-index: -1;
}

.sandrone-veil {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: -1;
  background:
    radial-gradient(120% 82% at 50% 20%, rgba(40, 30, 28, 0.14) 0%, rgba(40, 30, 28, 0.52) 100%),
    linear-gradient(180deg, rgba(42, 31, 29, 0.56) 0%, rgba(40, 30, 28, 0.70) 46%, rgba(28, 20, 19, 0.85) 100%);
}

/* 顶部品牌 + 游戏切换 */
.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 4rpx 28rpx;
}

.brand {
  display: flex;
  align-items: center;
}

.brand-mark {
  display: block;
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  overflow: hidden;
  margin-right: 16rpx;
  background: linear-gradient(135deg, #f6eee2, #c9ced9);
  box-shadow: 0 0 0 2rpx rgba(246, 238, 226, 0.45), 0 0 0 6rpx rgba(185, 48, 60, 0.22);
}

.brand-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #f6eee2;
  text-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.55);
}

/* 区块标题 */
.section-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin: 8rpx 4rpx 20rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 600;
  text-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.6);
}

.section-sub {
  font-size: 24rpx;
  color: #8b90a6;
  margin-top: 4rpx;
}

/* 按钮 */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 28rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
  border: 1rpx solid transparent;
}

.btn-primary {
  background: linear-gradient(135deg, #f07a81, #b9303c);
  color: #fff7f3;
  font-weight: 600;
  box-shadow: 0 8rpx 22rpx rgba(185, 48, 60, 0.28);
}

.btn-outline {
  border-color: rgba(240, 122, 129, 0.42);
  color: #f07a81;
  background: rgba(240, 122, 129, 0.06);
}

.btn-text {
  color: #8b90a6;
  background: transparent;
}

.btn-danger {
  color: #ff6b6b;
  border-color: rgba(255, 107, 107, 0.4);
}

.btn-sm {
  padding: 10rpx 20rpx;
  font-size: 24rpx;
}

.btn:active {
  opacity: 0.75;
}

.btn.disabled {
  opacity: 0.4;
}

/* 卡片 */
.panel {
  background: linear-gradient(165deg, rgba(38, 31, 40, 0.86), rgba(15, 15, 22, 0.94));
  border: 1rpx solid rgba(240, 122, 129, 0.18);
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 12rpx 30rpx rgba(0, 0, 0, 0.22);
}

.panel-title {
  padding-left: 16rpx;
  border-left: 6rpx solid rgba(240, 122, 129, 0.55);
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.3;
  margin-bottom: 12rpx;
}

.panel-desc {
  font-size: 24rpx;
  color: #8b90a6;
  margin-bottom: 20rpx;
}

.pool-tag {
  display: inline-block;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: #f07a81;
  border: 1rpx solid rgba(240, 122, 129, 0.32);
  background: rgba(240, 122, 129, 0.08);
}

.pool-tag.up {
  color: #ffb3b8;
  border-color: rgba(255, 212, 121, 0.45);
  background: rgba(255, 212, 121, 0.12);
}

.stars {
  color: #ffcf5c;
  font-size: 24rpx;
  margin-right: 6rpx;
}

.muted {
  color: #8b90a6;
}

.mono {
  font-variant-numeric: tabular-nums;
}

/* 统计卡片 2 列 */
.stat-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.stat-card {
  position: relative;
  width: 48.5%;
  box-sizing: border-box;
  background:
    radial-gradient(320rpx 150rpx at 100% -30%, rgba(240, 122, 129, 0.10), transparent 70%),
    #15161f;
  border: 1rpx solid rgba(240, 122, 129, 0.16);
  border-radius: 20rpx;
  padding: 26rpx 24rpx;
  margin-bottom: 16rpx;
  overflow: hidden;
}

.stat-card::before {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  height: 2rpx;
  background: linear-gradient(90deg, #f07a81, #f6eee2, transparent);
  opacity: 0.6;
}

.stat-card.tone-gold {
  background:
    radial-gradient(320rpx 150rpx at 100% -30%, rgba(240, 122, 129, 0.20), transparent 70%),
    #20202b;
  border-color: rgba(240, 122, 129, 0.26);
}

.stat-card.tone-purple {
  background:
    radial-gradient(320rpx 150rpx at 100% -30%, rgba(154, 120, 224, 0.22), transparent 70%),
    #20202b;
  border-color: rgba(166, 140, 240, 0.24);
}

.stat-card.tone-purple::before {
  background: linear-gradient(90deg, #c9adff, rgba(201, 173, 255, 0.2), transparent);
}

.stat-card.tone-purple .stat-value {
  color: #d5c2ff;
}

.stat-label {
  font-size: 22rpx;
  color: #8b90a6;
  letter-spacing: 1rpx;
}

.stat-value {
  font-size: 44rpx;
  font-weight: 700;
  color: #f6eee2;
  margin: 6rpx 0;
  word-break: break-all;
}

.stat-extra {
  font-size: 22rpx;
  color: #8b90a6;
}

/* 换算行 */
.convert-item {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 18rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.06);
}

.convert-item:last-child {
  border-bottom: 0;
}

.convert-item.highlight .convert-value {
  color: #ffb3b8;
}

.convert-label {
  font-size: 26rpx;
  color: #c8ccdb;
}

.convert-value {
  font-size: 30rpx;
  font-weight: 600;
  color: #f6eee2;
  margin-left: auto;
  margin-right: 16rpx;
}

.convert-note {
  font-size: 22rpx;
  color: #8b90a6;
  text-align: right;
  max-width: 46%;
}

/* 进度条 */
.pity-bar {
  height: 12rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.08);
  overflow: hidden;
  margin: 16rpx 0 14rpx;
}

.pity-bar-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #b9303c, #f6eee2);
}

/* 空状态 */
.empty {
  text-align: center;
  color: #8b90a6;
  font-size: 26rpx;
  padding: 40rpx 0;
}

/* 弹窗 */
.mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.62);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}

.modal {
  width: 100%;
  background: #101018;
  border-radius: 28rpx 28rpx 0 0;
  border-top: 1rpx solid rgba(240, 122, 129, 0.32);
  padding-bottom: env(safe-area-inset-bottom);
}

.modal-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 28rpx 16rpx;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
}

.modal-close {
  width: 56rpx;
  height: 56rpx;
  line-height: 52rpx;
  text-align: center;
  font-size: 40rpx;
  color: #8b90a6;
}

.modal-body {
  height: 58vh;
  box-sizing: border-box;
  padding: 0 28rpx;
}

.modal-foot {
  display: flex;
  justify-content: flex-end;
  padding: 20rpx 28rpx 28rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.06);
}

.modal-foot .btn {
  margin-left: 16rpx;
}

/* 表单 */
.form-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.06);
}

.form-label {
  font-size: 26rpx;
  color: #c8ccdb;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.form-control {
  flex: 1;
  text-align: right;
  font-size: 26rpx;
  color: #ecebe7;
  min-width: 0;
}

.form-input {
  flex: 1;
  text-align: right;
  font-size: 26rpx;
  color: #ecebe7;
  min-width: 0;
}

/* 手机文本录入 */
.text-tip {
  font-size: 22rpx;
  color: #8b90a6;
  line-height: 1.6;
}

.text-area {
  width: 100%;
  height: 360rpx;
  box-sizing: border-box;
  margin-top: 16rpx;
  padding: 20rpx;
  border-radius: 16rpx;
  background: #15161f;
  border: 1rpx solid rgba(240, 122, 129, 0.24);
  color: #ecebe7;
  font-size: 24rpx;
  line-height: 1.6;
}

.link-input {
  width: 100%;
  height: 84rpx;
  box-sizing: border-box;
  margin-top: 16rpx;
  padding: 0 20rpx;
  border-radius: 16rpx;
  background: #15161f;
  border: 1rpx solid rgba(240, 122, 129, 0.24);
  color: #ecebe7;
  font-size: 24rpx;
}

.picker-box {
  color: #f6eee2;
  font-size: 26rpx;
}

.picker-box::after {
  content: " ›";
  color: #8b90a6;
}

.switch {
  transform: scale(0.8);
  transform-origin: right center;
}

/* 列表行 */
.list-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.06);
}

.list-row:last-child {
  border-bottom: 0;
}

/* 工具条 */
.toolbar {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  margin-bottom: 20rpx;
}

.toolbar .btn {
  margin: 0 12rpx 12rpx 0;
}

.toolbar-title {
  flex: 1;
  font-size: 26rpx;
  color: #8b90a6;
  margin-bottom: 12rpx;
}

/* 页脚提示 */
.foot-tip {
  font-size: 22rpx;
  color: #6f7488;
  line-height: 1.7;
  padding: 8rpx 4rpx 0;
}

/* 云同步 */
.sync-row {
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
  margin-bottom: 12rpx;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid rgba(240, 122, 129, 0.22);
}

.sync-label {
  font-size: 24rpx;
  color: #8b90a6;
  margin-right: 16rpx;
  flex: none;
}

.sync-code {
  flex: 1;
  font-size: 24rpx;
  color: #f0c9a0;
  letter-spacing: 1rpx;
  word-break: break-all;
}

.sync-line {
  font-size: 24rpx;
  color: #8b90a6;
  margin-bottom: 16rpx;
}

.sync-auto {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 26rpx;
  color: #c9cddb;
  padding-top: 8rpx;
}

/* ---------------- AI 录入（三个页面共用） ---------------- */
.ai-textarea {
  width: 100%;
  height: 220rpx;
  box-sizing: border-box;
  margin-top: 12rpx;
  padding: 16rpx;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid rgba(211, 188, 142, 0.25);
  color: #e8eaf2;
  font-size: 26rpx;
  line-height: 1.6;
}

.ai-error {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #ff8a8a;
  line-height: 1.6;
}

.ai-list {
  margin-top: 16rpx;
}

.ai-row {
  display: flex;
  align-items: center;
  padding: 12rpx 14rpx;
  margin-bottom: 8rpx;
  border-radius: 10rpx;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  font-size: 24rpx;
}

.ai-index {
  width: 40rpx;
  color: #6f7488;
  font-size: 22rpx;
  text-align: right;
  margin-right: 10rpx;
}

.ai-name {
  flex: 1;
  color: #e8eaf2;
  font-weight: 600;
}

.ai-meta {
  margin-left: 10rpx;
  color: #8b90a6;
  font-size: 22rpx;
}

.ai-tag {
  margin-left: 10rpx;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  color: #8b90a6;
  background: rgba(255, 255, 255, 0.06);
}

.ai-tag.up {
  color: #1b1a16;
  background: #d3bc8e;
}

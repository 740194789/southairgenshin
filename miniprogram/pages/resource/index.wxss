.convert-item {
  display: block;
  padding: 20rpx 0;
}

.convert-line {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.convert-item .convert-value {
  margin-right: 0;
}

.convert-note {
  max-width: 100%;
  text-align: left;
  margin-top: 4rpx;
}

.section-head .btn {
  flex-shrink: 0;
  margin-left: 16rpx;
}

.head-actions {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.head-actions .btn {
  margin-left: 12rpx;
  white-space: nowrap;
}

/* 养成经验 */

.exp-card {
  padding: 20rpx 22rpx;
  margin-top: 16rpx;
  border-radius: 16rpx;
  border: 1rpx solid rgba(211, 188, 142, 0.16);
  background: #171b2b;
}

.exp-card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #f2e2bd;
  margin-bottom: 10rpx;
}

.exp-count,
.exp-total {
  font-size: 24rpx;
  color: #8b90a6;
  line-height: 1.7;
}

.exp-total {
  color: #c8ccdb;
  margin-bottom: 6rpx;
}

.exp-result {
  font-size: 24rpx;
  color: #8b90a6;
  line-height: 1.7;
}

.exp-strong {
  font-size: 28rpx;
  font-weight: 600;
  color: #ffd479;
}

.exp-note {
  font-size: 22rpx;
  color: #6f7488;
  margin-top: 4rpx;
}

.exp-level-box {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: flex-end;
  gap: 16rpx;
  min-width: 0;
}

.exp-level-box .form-input {
  flex: 1;
}

.exp-level-box .btn {
  flex-shrink: 0;
}

.exp-plan {
  margin-top: 16rpx;
  padding-top: 12rpx;
  border-top: 1rpx dashed rgba(211, 188, 142, 0.2);
}

.exp-plan-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 10rpx 0;
  font-size: 24rpx;
  color: #8b90a6;
  line-height: 1.6;
}

.exp-row-del {
  flex-shrink: 0;
  width: 44rpx;
  height: 44rpx;
  line-height: 42rpx;
  text-align: center;
  border-radius: 50%;
  border: 1rpx solid rgba(211, 188, 142, 0.28);
  color: #8b90a6;
  font-size: 26rpx;
}

.exp-sum {
  margin-top: 8rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid rgba(211, 188, 142, 0.16);
  font-size: 24rpx;
  color: #c8ccdb;
  line-height: 1.7;
}


<view wx:if="{{visible}}" class="np-mask" catchtouchmove="noop">
  <view class="np-modal" catchtap="noop">
    <view class="np-head">
      <text class="np-title">选择角色 / 物品</text>
      <view class="np-close" bindtap="close">×</view>
    </view>

    <view class="np-search">
      <input class="np-search-input" value="{{keyword}}" placeholder="搜索角色 / 物品名称"
             placeholder-style="color:#6d7288" confirm-type="search"
             bindinput="onSearch" bindconfirm="noop"/>
    </view>

    <view wx:if="{{showTabs && tabs.length > 1 && !searching}}" class="np-tabs">
      <view wx:for="{{tabs}}" wx:key="key" class="np-tab {{activeTab === item.key ? 'active' : ''}}"
            data-key="{{item.key}}" bindtap="switchTab">
        {{item.label}}<text class="np-count">{{item.count}}</text>
      </view>
    </view>

    <scroll-view scroll-y class="np-body">
      <view class="np-body-inner">
        <view wx:if="{{cells.length}}" class="np-grid">
          <view wx:for="{{cells}}" wx:key="name" class="np-cell {{item.name === current ? 'active' : ''}}"
                data-name="{{item.name}}" data-icon="{{item.icon}}" bindtap="pick">
            <view class="np-icon">
              <text>{{item.initial}}</text>
              <image wx:if="{{item.icon}}" src="{{item.icon}}" mode="aspectFill"
                     data-index="{{index}}" binderror="onIconError"/>
            </view>
            <view class="np-name">{{item.name}}</view>
          </view>
        </view>
        <view wx:else class="np-empty">{{keyword ? '没有匹配的名称' : '暂无可选名称'}}</view>
      </view>
    </scroll-view>
  </view>
</view>

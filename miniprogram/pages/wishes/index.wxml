<view class="page">
  <view class="topbar" style="padding-top: {{statusBarHeight + 36}}px">
    <view class="brand">
      <view class="brand-mark">SA</view>
      <view class="brand-name">SouthAir Genshin</view>
    </view>
    <game-switch game="{{game}}" bind:change="onSwitchGame" />
  </view>

  <view class="section-head">
    <view>
      <view class="section-title">抽卡记录</view>
      <view class="section-sub">五星出货记录 · 记录抽到五星用了多少抽 · 支持导入导出</view>
    </view>
  </view>

  <view class="toolbar">
    <picker class="pool-picker" range="{{poolOptions}}" value="{{poolIndex}}" bindchange="onPoolChange">
      <view class="pool-picker-box">{{poolOptions[poolIndex]}} ▾</view>
    </picker>
    <view class="toolbar-title">共 {{total}} 条</view>
  </view>

  <view class="btn-row">
    <view class="btn btn-primary btn-sm" bindtap="openAdd">录入五星</view>
    <view class="btn btn-text btn-sm {{rows.length ? '' : 'disabled'}}" bindtap="toggleAll">{{allChecked ? '取消全选' : '全选本页'}}</view>
    <view class="btn btn-danger btn-sm {{selectedCount ? '' : 'disabled'}}" bindtap="deleteSelected">批量删除{{selectedCount ? '（' + selectedCount + '）' : ''}}</view>
    <view class="btn btn-outline btn-sm" bindtap="exportCsv">导出 CSV</view>
    <view class="btn btn-outline btn-sm" bindtap="exportJson">导出 JSON</view>
    <view class="btn btn-text btn-sm" bindtap="downloadTemplate">JSON 模板</view>
    <view class="btn btn-text btn-sm" bindtap="openTextImport">文本导入</view>
    <view class="btn btn-outline btn-sm" bindtap="importRecords">文件导入</view>
  </view>

  <view class="wish-pity" wx:if="{{pityChips.length}}">
    <view class="wish-pity-chip {{item.guaranteed ? 'guaranteed' : ''}}" wx:for="{{pityChips}}" wx:key="pool"
      bindtap="editPity" data-pool="{{item.pool}}" data-cap="{{item.cap}}" data-pity="{{item.currentPity}}">
      <text>{{item.pool}} 已垫 {{item.currentPity}} / {{item.cap}} 抽 · 距保底 {{item.left}} 抽{{item.guaranteed ? ' · 大保底' : ''}}</text>
      <text class="wish-pity-manual" wx:if="{{item.manual}}">手动</text>
    </view>
  </view>

  <block wx:if="{{rows.length}}">
    <view class="record" wx:for="{{rows}}" wx:key="id">
      <view class="record-top">
        <view class="check {{item.checked ? 'on' : ''}}" data-id="{{item.id}}" bindtap="toggleSelect">{{item.checked ? '✓' : ''}}</view>
        <view class="record-name">
          <text class="stars">{{item.stars}}</text>
          <text class="{{item.rarity === 3 ? 'muted' : ''}}">{{item.displayName}}</text>
        </view>
        <text class="pool-tag {{item.isUp ? 'up' : ''}}">{{item.pool}}</text>
      </view>

      <view class="record-meta">
        <text>{{item.itemType}}</text>
        <text wx:if="{{item.rarity === 5}}">{{item.isUp ? 'UP 内' : '未中 UP'}}</text>
        <text wx:if="{{item.rarity === 5}}">用了 {{item.pityCount}} 抽</text>
        <text wx:if="{{item.rarity === 5 && item.capture}}" style="color:#7ad7c0">捕获明光</text>
        <text class="record-time">{{item.time}}</text>
      </view>

      <view class="record-bottom">
        <text class="record-id">#{{item.id}}</text>
        <view class="record-actions">
          <text class="link" data-id="{{item.id}}" bindtap="editRow">编辑</text>
          <text class="link danger" data-id="{{item.id}}" bindtap="removeRow">删除</text>
        </view>
      </view>
    </view>
  </block>

  <view wx:if="{{!rows.length}}" class="panel">
    <view class="empty">暂无抽卡记录，点击「录入五星」开始记录</view>
  </view>

  <view class="pager" wx:if="{{total > 0}}">
    <view class="btn btn-text btn-sm {{page <= 1 ? 'disabled' : ''}}" bindtap="prevPage">上一页</view>
    <text class="pager-info">第 {{page}} / {{pages}} 页 · 共 {{total}} 条</text>
    <view class="btn btn-text btn-sm {{page >= pages ? 'disabled' : ''}}" bindtap="nextPage">下一页</view>
  </view>

  <view class="foot-tip">每页 10 条；勾选仅对当前页有效，翻页 / 切卡池 / 切游戏会自动清空。只记录四星角色与五星物品，导入合并时按「名称 + 卡池 + 时间」去重。</view>
</view>

<!-- 单条编辑 -->
<view wx:if="{{editorVisible}}" class="mask" bindtap="closeEditor">
  <view class="modal" catchtap="noop">
    <view class="modal-head">
      <text class="modal-title">{{editorId ? '编辑抽卡' : '录入五星'}} · {{g.fullName}}</text>
      <view class="modal-close" bindtap="closeEditor">×</view>
    </view>
    <scroll-view scroll-y class="modal-body">
      <view class="form-row">
        <text class="form-label">抽到的五星</text>
        <input class="form-input" value="{{editor.itemName}}" bindinput="onEditorName"
               placeholder="{{g.itemTypes[0]}} / {{g.itemTypes[1]}}名称"/>
      </view>
      <view class="form-row">
        <text class="form-label">类型</text>
        <picker class="form-picker" range="{{typeOptions}}" value="{{editor.typeIndex}}" bindchange="onEditorType">
          <view class="picker-box">{{typeOptions[editor.typeIndex]}}</view>
        </picker>
      </view>
      <view class="form-row">
        <text class="form-label">卡池</text>
        <picker class="form-picker" range="{{g.pools}}" value="{{editor.poolIndex}}" bindchange="onEditorPool">
          <view class="picker-box">{{g.pools[editor.poolIndex]}}</view>
        </picker>
      </view>
      <view class="form-row">
        <text class="form-label">是否 UP</text>
        <switch class="switch" color="#d3bc8e" checked="{{editor.isUp}}" bindchange="onEditorUp"/>
      </view>
      <view class="form-row" wx:if="{{game === 'genshin'}}">
        <text class="form-label">触发捕获明光</text>
        <switch class="switch" color="#d3bc8e" checked="{{editor.capture}}" bindchange="onEditorCapture"/>
      </view>
      <view class="form-row">
        <text class="form-label">抽到五星用了多少抽</text>
        <input class="form-input" type="number" value="{{editor.pity}}" bindinput="onEditorPity" placeholder="1"/>
      </view>
      <view class="form-row">
        <text class="form-label">抽卡时间</text>
        <view class="form-datetime">
          <picker mode="date" value="{{editor.date}}" bindchange="onEditorDate">
            <view class="picker-box">{{editor.date}}</view>
          </picker>
          <picker mode="time" value="{{editor.time}}" bindchange="onEditorTime">
            <view class="picker-box picker-time">{{editor.time}}</view>
          </picker>
        </view>
      </view>
      <view class="form-row">
        <text class="form-label">备注</text>
        <input class="form-input" value="{{editor.note}}" bindinput="onEditorNote" placeholder="可选"/>
      </view>
      <view class="foot-tip">只记录四星角色与五星物品；三星物品、四星武器 / 光锥不记录。</view>
    </scroll-view>
    <view class="modal-foot">
      <view class="btn btn-text" bindtap="closeEditor">取消</view>
      <view class="btn btn-primary" bindtap="saveEditor">保存</view>
    </view>
  </view>
</view>

<!-- 文本导入：手机直接填写，不需要生成 / 编辑文件 -->
<view wx:if="{{textVisible}}" class="mask" bindtap="closeTextImport">
  <view class="modal" catchtap="noop">
    <view class="modal-head">
      <text class="modal-title">文本导入 · {{g.fullName}}</text>
      <view class="modal-close" bindtap="closeTextImport">×</view>
    </view>
    <view class="modal-body" style="height:auto; padding-bottom:16rpx;">
      <view class="text-tip">每行一条，字段用英文逗号分隔：</view>
      <view class="text-tip">时间, 名称, 星级, 类型, 卡池, 是否UP, 保底计数, 备注</view>
      <view class="text-tip">也可以粘贴 JSON 文本（记录数组、单游戏备份或全量备份内容）。</view>
      <textarea class="text-area" value="{{textContent}}" bindinput="onTextInput" maxlength="-1"
                placeholder="2026-10-31 12:30,神里绫华,5,角色,角色活动,UP,78"></textarea>
      <view class="foot-tip">示例行是三星物品，导入时会被忽略；时间写成 2026-10-31 12:30 即可，备注可留空。</view>
    </view>
    <view class="modal-foot">
      <view class="btn btn-text" bindtap="closeTextImport">取消</view>
      <view class="btn btn-primary" bindtap="applyTextImport">导入</view>
    </view>
  </view>
</view>


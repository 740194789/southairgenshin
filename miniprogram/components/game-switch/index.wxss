.game-switch {
  display: flex;
  padding: 4rpx;
  background: rgba(23, 27, 43, 0.9);
  border: 1rpx solid rgba(211, 188, 142, 0.32);
  border-radius: 999rpx;
}

.game-btn {
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #8b90a6;
}

.game-btn.active {
  background: linear-gradient(135deg, #f2e2bd, #d3bc8e);
  color: #1b1a16;
  font-weight: 600;
}

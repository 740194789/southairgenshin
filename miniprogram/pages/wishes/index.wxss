.pool-picker-box {
  padding: 10rpx 20rpx;
  border: 1rpx solid rgba(211, 188, 142, 0.32);
  border-radius: 12rpx;
  color: #d3bc8e;
  font-size: 24rpx;
  background: rgba(211, 188, 142, 0.06);
}

.toolbar-title {
  margin: 0 0 0 16rpx;
  flex: none;
  font-size: 24rpx;
  color: #8b90a6;
}

.btn-row {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 16rpx;
}

.btn-row .btn {
  margin: 0 12rpx 12rpx 0;
}

.record {
  background: #171b2b;
  border: 1rpx solid rgba(211, 188, 142, 0.16);
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 16rpx;
}

.record-top {
  display: flex;
  align-items: center;
}

.check {
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  border-radius: 50%;
  border: 1rpx solid rgba(211, 188, 142, 0.42);
  color: #1b1a16;
  font-size: 22rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.check.on {
  background: #d3bc8e;
  border-color: #d3bc8e;
}

.record-name {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.record-top .pool-tag {
  flex-shrink: 0;
  margin-left: 12rpx;
}

.record-meta {
  display: flex;
  flex-wrap: wrap;
  font-size: 22rpx;
  color: #8b90a6;
  margin-top: 10rpx;
  padding-left: 56rpx;
}

.record-meta text {
  margin-right: 20rpx;
}

.record-time {
  color: #a9adc0;
}

.record-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 10rpx;
  padding-left: 56rpx;
}

.record-id {
  font-size: 20rpx;
  color: #6f7488;
}

.record-actions .link {
  font-size: 24rpx;
  color: #d3bc8e;
  margin-left: 28rpx;
}

.record-actions .link.danger {
  color: #ff6b6b;
}

.record-actions .link:active {
  opacity: 0.7;
}

.pager {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 12rpx 0;
}

.pager-info {
  font-size: 24rpx;
  color: #8b90a6;
  margin: 0 20rpx;
}

.form-picker {
  flex: 1;
  text-align: right;
}

.form-datetime {
  display: flex;
  align-items: center;
  flex: 1;
  justify-content: flex-end;
}

.picker-time {
  margin-left: 16rpx;
}


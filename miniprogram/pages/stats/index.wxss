.hero {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 28rpx;
  border-radius: 24rpx;
  margin-bottom: 24rpx;
  background:
    radial-gradient(520rpx 260rpx at 8% -20%, rgba(211, 188, 142, 0.22), transparent 62%),
    #171b2b;
  border: 1rpx solid rgba(211, 188, 142, 0.32);
  box-shadow: 0 20rpx 48rpx rgba(0, 0, 0, 0.32);
  overflow: hidden;
}

.hero::after {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  height: 1rpx;
  background: linear-gradient(90deg, rgba(211, 188, 142, 0.7), transparent 70%);
}

.hero-main {
  flex: 1;
  min-width: 0;
}

.hero-sub {
  font-size: 22rpx;
  letter-spacing: 2rpx;
  color: #8b90a6;
  text-transform: uppercase;
}

.hero-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #f2e2bd;
  margin: 4rpx 0 8rpx;
}

.hero-desc {
  font-size: 24rpx;
  color: #a9adc0;
}

.strong {
  color: #ffd479;
  font-weight: 600;
}

.hero-badge {
  flex-shrink: 0;
  margin-left: 16rpx;
  text-align: center;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  border: 1rpx solid rgba(211, 188, 142, 0.32);
  background: rgba(211, 188, 142, 0.08);
}

.hero-badge-label {
  font-size: 22rpx;
  color: #8b90a6;
}

.hero-badge-value {
  font-size: 36rpx;
  font-weight: 700;
  color: #f2e2bd;
}

/* ---------- 统计页分组 ---------- */

.stats-tabs {
  display: flex;
  align-items: center;
  margin: 0 0 24rpx;
  padding: 6rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(211, 188, 142, 0.22);
  background: rgba(9, 11, 20, 0.55);
}

.stats-tab {
  flex: 1;
  padding: 14rpx 0;
  border-radius: 999rpx;
  border: 1rpx solid transparent;
  background: transparent;
  font-size: 24rpx;
  color: #8b90a6;
  text-align: center;
}

.stats-tab + .stats-tab {
  margin-left: 4rpx;
}

.stats-tab.active {
  color: #14161f;
  font-weight: 600;
  border-color: transparent;
  background: linear-gradient(135deg, #f2e2bd, #d3bc8e);
  box-shadow: 0 8rpx 20rpx rgba(211, 188, 142, 0.22);
}

.inline {
  margin-left: 12rpx;
  font-size: 22rpx;
}

.pity-line {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  font-size: 24rpx;
  color: #c8ccdb;
  margin-bottom: 10rpx;
}

.pity-note {
  font-size: 22rpx;
  color: #8b90a6;
  line-height: 1.65;
  margin-top: 6rpx;
}

.pool-stat {
  padding: 18rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.06);
}

.pool-stat:last-child {
  border-bottom: 0;
  padding-bottom: 4rpx;
}

.pool-stat-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.pool-pity {
  font-size: 24rpx;
  color: #c8ccdb;
}

.pool-meta {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  font-size: 22rpx;
  color: #8b90a6;
}

.pool-meta text {
  margin-right: 20rpx;
}

.bar-row {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
}

.bar-name {
  width: 150rpx;
  font-size: 24rpx;
  color: #c8ccdb;
  flex-shrink: 0;
}

.bar-track {
  flex: 1;
  height: 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.08);
  overflow: hidden;
  margin: 0 16rpx;
}

.bar-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #9f8b5f, #f2e2bd);
  box-shadow: 0 0 16rpx rgba(211, 188, 142, 0.28);
}

.bar-count {
  width: 70rpx;
  text-align: right;
  font-size: 24rpx;
  color: #f2e2bd;
  flex-shrink: 0;
}

.recent-name {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  color: #ecebe7;
}

.recent-avatar {
  position: relative;
  flex-shrink: 0;
  width: 36rpx;
  height: 36rpx;
  margin-right: 8rpx;
  border-radius: 50%;
  overflow: hidden;
  background: rgba(211, 188, 142, 0.12);
  border: 1rpx solid rgba(211, 188, 142, 0.24);
}

.recent-avatar image {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.recent-time {
  font-size: 22rpx;
  color: #8b90a6;
}

/* ---------- 五星抽数柱形图 ---------- */

.pull-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.pull-toggle {
  font-size: 20rpx;
  color: #c8ccdb;
  border: 1rpx solid rgba(211, 188, 142, 0.4);
  border-radius: 999rpx;
  padding: 6rpx 18rpx;
}

.pull-toggle.active {
  color: #ffd479;
  border-color: rgba(255, 212, 121, 0.7);
}

.pull-pools {
  display: flex;
  flex-wrap: wrap;
  margin: 16rpx 0 14rpx;
}

.pull-pool {
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(211, 188, 142, 0.28);
  font-size: 22rpx;
  color: #8b90a6;
}

.pull-pool + .pull-pool {
  margin-left: 12rpx;
}

.pull-pool.active {
  background: rgba(211, 188, 142, 0.16);
  border-color: rgba(211, 188, 142, 0.6);
  color: #d3bc8e;
}

.pull-summary {
  font-size: 22rpx;
  color: #8b90a6;
  line-height: 1.6;
  margin-bottom: 16rpx;
}

.pull-scroll {
  width: 100%;
  white-space: nowrap;
}

.pull-chart {
  display: flex;
  flex-direction: column;
  padding: 0 4rpx;
}

.pull-row {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.pull-row:last-child {
  margin-bottom: 0;
}

.pull-label {
  display: flex;
  align-items: center;
  min-width: 0;
  width: 150rpx;
  flex-shrink: 0;
}

.pull-avatar {
  position: relative;
  flex-shrink: 0;
  width: 30rpx;
  height: 30rpx;
  margin-right: 6rpx;
  border-radius: 50%;
  overflow: hidden;
  background: rgba(211, 188, 142, 0.12);
  border: 1rpx solid rgba(211, 188, 142, 0.24);
}

.pull-avatar image {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.pull-name {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: 20rpx;
  color: #8b90a6;
}

.pull-track {
  flex: 1;
  height: 20rpx;
  margin: 0 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.06);
  overflow: hidden;
}

.pull-bar {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #9f8b5f, #f2e2bd);
  box-shadow: 0 0 16rpx rgba(211, 188, 142, 0.26);
}

.pull-row.lost .pull-bar {
  background: linear-gradient(90deg, #444a5e, #6b7185);
}

.pull-val {
  width: 56rpx;
  flex-shrink: 0;
  text-align: right;
  font-size: 20rpx;
  color: #f2e2bd;
}

/* ---------- 抽卡期望 ---------- */
.expect-modes {
  display: flex;
  margin-top: 18rpx;
}

.expect-mode + .expect-mode {
  margin-left: 12rpx;
}

.expect-mode {
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(211, 188, 142, 0.28);
  font-size: 22rpx;
  color: #8b90a6;
}

.expect-mode.is-on {
  background: rgba(211, 188, 142, 0.16);
  border-color: rgba(211, 188, 142, 0.6);
  color: #d3bc8e;
}

.expect-mode.is-disabled {
  opacity: 0.4;
}

.expect-targets {
  display: flex;
  margin-top: 20rpx;
}

.expect-target + .expect-target {
  margin-left: 18rpx;
}

.expect-target {
  flex: 1;
  padding: 16rpx 18rpx;
  border-radius: 16rpx;
  background: #171b2b;
  border: 1rpx solid rgba(211, 188, 142, 0.12);
}

.expect-target-label {
  font-size: 20rpx;
  color: #8b90a6;
}

.expect-stepper {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 12rpx 0 8rpx;
}

.expect-step {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #1e2437;
  color: #d3bc8e;
  font-size: 30rpx;
  line-height: 56rpx;
  text-align: center;
}

.expect-step.is-disabled {
  opacity: 0.35;
}

.expect-step-value {
  font-size: 30rpx;
  font-weight: 600;
  color: #ecebe7;
}

.expect-unit {
  margin-left: 4rpx;
  font-size: 20rpx;
  color: #8b90a6;
}

.expect-target-note {
  font-size: 20rpx;
  color: #8b90a6;
}

.expect-readout {
  margin-top: 20rpx;
  padding: 20rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, rgba(211, 188, 142, 0.14), rgba(211, 188, 142, 0.03));
  border: 1rpx solid rgba(211, 188, 142, 0.26);
}

.expect-kicker {
  font-size: 22rpx;
  color: #8b90a6;
}

.expect-number {
  margin: 8rpx 0 4rpx;
  font-size: 52rpx;
  font-weight: 700;
  line-height: 1.1;
  color: #d3bc8e;
}

.expect-number.is-range {
  font-size: 44rpx;
  letter-spacing: -0.5rpx;
  white-space: nowrap;
}

.expect-number .expect-unit {
  margin-left: 8rpx;
  font-size: 24rpx;
  font-weight: 400;
}

.expect-compare {
  font-size: 22rpx;
  line-height: 1.6;
  color: #c3c7d8;
}

.expect-bar {
  height: 10rpx;
  margin-top: 14rpx;
  border-radius: 999rpx;
  background: #232838;
  overflow: hidden;
}

.expect-bar-fill {
  height: 100%;
  border-radius: 999rpx;
  background: #d3bc8e;
}

.expect-bar-fill.done {
  background: #7dd3a0;
}

.expect-split {
  display: flex;
  margin-top: 16rpx;
}

.expect-part + .expect-part {
  margin-left: 18rpx;
}

.expect-part {
  flex: 1;
  padding: 16rpx;
  border-radius: 14rpx;
  background: #171b2b;
  border: 1rpx solid rgba(211, 188, 142, 0.12);
}

.expect-part-label {
  font-size: 20rpx;
  color: #8b90a6;
}

.expect-part-value {
  margin: 4rpx 0;
  font-size: 30rpx;
  font-weight: 600;
  color: #ecebe7;
}

.expect-part-note {
  font-size: 20rpx;
  color: #8b90a6;
}

.expect-note {
  margin-top: 12rpx;
  font-size: 20rpx;
  line-height: 1.6;
  color: #8b90a6;
}

/* ---------- 攒抽规划 ---------- */

.expect-planner {
  margin-top: 20rpx;
  padding: 20rpx 22rpx;
  border-radius: 16rpx;
  border: 1rpx dashed rgba(211, 188, 142, 0.4);
  background: rgba(9, 11, 20, 0.45);
}

.planner-head {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  margin-bottom: 16rpx;
}

.planner-title {
  font-size: 26rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  color: #d3bc8e;
}

.planner-sub {
  margin-left: 12rpx;
  font-size: 20rpx;
  color: #71778e;
}

.planner-fields {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 18rpx;
}

.planner-field {
  display: flex;
  align-items: center;
  margin: 0 20rpx 12rpx 0;
  font-size: 22rpx;
  color: #8b90a6;
}

.planner-input {
  width: 128rpx;
  height: 52rpx;
  margin: 0 8rpx;
  padding: 0 12rpx;
  border-radius: 10rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  background: rgba(9, 11, 20, 0.72);
  color: #ecebe7;
  font-size: 24rpx;
  line-height: 52rpx;
  text-align: center;
}

.planner-numbers {
  display: flex;
  margin-bottom: 14rpx;
}

.planner-rate {
  margin: -6rpx 0 14rpx;
  font-size: 20rpx;
  line-height: 1.5;
  color: #71778e;
}

/* 卡池日历（内置数据） */
.calendar-row {
  display: flex;
  align-items: center;
  padding: 18rpx 20rpx;
  margin-bottom: 14rpx;
  border-radius: 16rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  background: rgba(255, 255, 255, 0.02);
}

.calendar-row.is-current {
  border-color: rgba(231, 197, 128, 0.35);
  background: rgba(231, 197, 128, 0.06);
}

.calendar-badge {
  flex: 0 0 auto;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  font-size: 20rpx;
  color: #71778e;
}

.calendar-row.is-current .calendar-badge {
  color: #e7c580;
  border-color: rgba(231, 197, 128, 0.4);
}

.calendar-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
  margin: 0 16rpx;
}

.calendar-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #e8ebf2;
}

.calendar-line {
  margin-top: 4rpx;
  font-size: 22rpx;
  line-height: 1.4;
  color: #9aa1b5;
}

.planner-num {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
  padding: 12rpx 14rpx;
  border-radius: 12rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  background: rgba(255, 255, 255, 0.02);
}

.planner-num + .planner-num {
  margin-left: 12rpx;
}

.planner-num-label {
  font-size: 20rpx;
  color: #8b90a6;
}

.planner-num-value {
  margin-top: 4rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #d3bc8e;
}

/* 定轨目标 */
.fate-row {
  display: flex;
  align-items: center;
  margin-top: 14rpx;
}

.fate-picker {
  padding: 8rpx 16rpx;
  border-radius: 10rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  font-size: 22rpx;
  color: #9aa1b5;
}

.fate-row .pool-tag {
  margin-left: 12rpx;
}

/* 战绩卡离屏画布 */
.battle-canvas {
  position: fixed;
  left: -2000px;
  top: 0;
  width: 720px;
  height: 1000px;
  pointer-events: none;
}

.convert-item {
  display: block;
  padding: 20rpx 0;
}

.convert-line {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.convert-item .convert-value {
  margin-right: 0;
}

.convert-note {
  max-width: 100%;
  text-align: left;
  margin-top: 4rpx;
}

.section-head .btn {
  flex-shrink: 0;
  margin-left: 16rpx;
}

.head-actions {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.head-actions .btn {
  margin-left: 12rpx;
  white-space: nowrap;
}

/* 养成经验 */

.resource-tools {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.tool-btn {
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(240, 122, 129, 0.26);
  background: rgba(240, 122, 129, 0.06);
  color: #c8ccdb;
  font-size: 24rpx;
  line-height: 1.4;
}

.tool-btn.active {
  color: #1b1a16;
  background: linear-gradient(135deg, #f6eee2, #f07a81);
  border-color: transparent;
  font-weight: 600;
}

.stock-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.stock-item {
  width: 48.5%;
  box-sizing: border-box;
  padding: 18rpx 20rpx;
  margin-bottom: 16rpx;
  border-radius: 14rpx;
  border: 1rpx solid rgba(240, 122, 129, 0.16);
  background: #15161f;
}

.stock-label {
  font-size: 22rpx;
  color: #8b90a6;
}

.stock-value {
  font-size: 34rpx;
  font-weight: 600;
  color: #f6eee2;
  margin: 4rpx 0;
}

.stock-note {
  font-size: 20rpx;
  color: #6f7488;
}

.exp-char-pick {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  flex: 1;
  gap: 8rpx;
  font-size: 26rpx;
  color: #f6eee2;
}

.exp-char-arrow {
  color: #8b90a6;
  font-size: 26rpx;
}

.exp-card {
  padding: 20rpx 22rpx;
  margin-top: 16rpx;
  border-radius: 16rpx;
  border: 1rpx solid rgba(240, 122, 129, 0.16);
  background: #15161f;
}

.exp-card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #f6eee2;
  margin-bottom: 10rpx;
}

.exp-count,
.exp-total {
  font-size: 24rpx;
  color: #8b90a6;
  line-height: 1.7;
}

.exp-total {
  color: #c8ccdb;
  margin-bottom: 6rpx;
}

.exp-result {
  font-size: 24rpx;
  color: #8b90a6;
  line-height: 1.7;
}

.exp-strong {
  font-size: 28rpx;
  font-weight: 600;
  color: #ffb3b8;
}

.exp-note {
  font-size: 22rpx;
  color: #6f7488;
  margin-top: 4rpx;
}

.exp-actions {
  display: flex;
  justify-content: flex-end;
  margin: 8rpx 0 6rpx;
}

.exp-plan {
  margin-top: 16rpx;
  padding-top: 12rpx;
  border-top: 1rpx dashed rgba(240, 122, 129, 0.2);
}

.exp-plan-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 10rpx 0;
  font-size: 24rpx;
  color: #8b90a6;
  line-height: 1.6;
}

.exp-row-del {
  flex-shrink: 0;
  width: 44rpx;
  height: 44rpx;
  line-height: 42rpx;
  text-align: center;
  border-radius: 50%;
  border: 1rpx solid rgba(240, 122, 129, 0.28);
  color: #8b90a6;
  font-size: 26rpx;
}

.exp-sum {
  margin-top: 8rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid rgba(240, 122, 129, 0.16);
  font-size: 24rpx;
  color: #c8ccdb;
  line-height: 1.7;
}

.exp-flower {
  margin-top: 18rpx;
  padding: 16rpx 18rpx;
  border-radius: 14rpx;
  border: 1rpx solid rgba(240, 122, 129, 0.18);
  background: rgba(240, 122, 129, 0.05);
}

.exp-flower-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  font-size: 24rpx;
  color: #8b90a6;
}

.exp-wl-picker {
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(240, 122, 129, 0.32);
  background: rgba(12, 15, 24, 0.6);
  color: #f6eee2;
  font-size: 22rpx;
}

.exp-flower-per {
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #7d849a;
}


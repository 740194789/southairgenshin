<view class="page">
  <view class="topbar" style="padding-top: {{statusBarHeight + 36}}px">
    <view class="brand">
      <view class="brand-mark">SA</view>
      <view class="brand-name">SouthAir Genshin</view>
    </view>
    <game-switch game="{{game}}" bind:change="onSwitchGame" />
  </view>

  <view class="section-head">
    <view>
      <view class="section-title">账号资源</view>
      <view class="section-sub">{{g.fullName}} · 资源与抽数换算</view>
    </view>
    <view class="head-actions">
      <view class="btn btn-outline btn-sm" bindtap="openEdit">编辑资源</view>
    </view>
  </view>

  <view class="stat-grid">
    <view class="stat-card">
      <view class="stat-label">{{g.currency}}</view>
      <view class="stat-value">{{res.primogemsText}}</view>
      <view class="stat-extra">≈ {{res.pullsFromPrimogems}} 抽</view>
    </view>
    <view class="stat-card">
      <view class="stat-label">{{g.credit}}</view>
      <view class="stat-value">{{res.moraText}}</view>
      <view class="stat-extra">游戏内货币</view>
    </view>
    <view class="stat-card">
      <view class="stat-label">{{g.fateLimited}}</view>
      <view class="stat-value">{{res.intertwinedFatesText}}</view>
      <view class="stat-extra">限定池抽数</view>
    </view>
    <view class="stat-card">
      <view class="stat-label">{{g.fateStandard}}</view>
      <view class="stat-value">{{res.acquaintedFatesText}}</view>
      <view class="stat-extra">常驻池抽数 · 不计入可抽数</view>
    </view>
  </view>

  <view class="resource-tools" wx:if="{{game === 'genshin'}}">
    <view class="tool-btn {{showStock ? 'active' : ''}}" bindtap="toggleStock">经验素材</view>
    <view class="tool-btn {{showExp ? 'active' : ''}}" bindtap="toggleExp">养成经验</view>
  </view>

  <view class="panel" wx:if="{{game === 'genshin' && showStock}}">
    <view class="panel-title">经验素材</view>
    <view class="panel-desc">当前持有数量，在「编辑资源」里修改。</view>
    <view class="stock-grid">
      <view class="stock-item" wx:for="{{stockItems}}" wx:key="label">
        <view class="stock-label">{{item.label}}</view>
        <view class="stock-value">{{item.valueText}}</view>
        <view class="stock-note">{{item.note}}</view>
      </view>
    </view>
  </view>

  <view class="panel" wx:if="{{game === 'genshin' && showExp}}">
    <view class="panel-title">养成经验</view>
    <view class="panel-desc">按持有经验素材推算可练到的等级，数量在「经验素材」里查看。</view>

    <view class="exp-card">
      <view class="exp-card-title">角色经验书</view>
      <view class="exp-total">合计经验 {{exp.charTotalText}}</view>
      <view class="form-row">
        <text class="form-label">角色</text>
        <view class="exp-char-pick" bindtap="onOpenPicker">
          <text>{{selectedChar || '选择角色'}}</text>
          <text class="exp-char-arrow">›</text>
        </view>
      </view>
      <view class="form-row">
        <text class="form-label">当前等级</text>
        <picker class="form-control" range="{{fromLevels}}" value="{{fromIndex}}" bindchange="onCharFrom">
          <view class="picker-box">{{fromLevels[fromIndex]}}</view>
        </picker>
      </view>
      <view class="form-row">
        <text class="form-label">目标等级</text>
        <picker class="form-control" range="{{toLevels}}" value="{{toIndex}}" bindchange="onCharTo">
          <view class="picker-box">{{toLevels[toIndex]}}</view>
        </picker>
      </view>
      <view class="exp-actions">
        <view class="btn btn-outline btn-sm" bindtap="onAddChar">保留结果</view>
      </view>
      <view class="exp-result">{{exp.charPreviewText}}</view>
      <view class="exp-note">90 级后需「无主的命星」：90 → 95 用 1 枚，90 → 100 共 3 枚；95 → 100 用 2 枚，不再消耗经验书。</view>
      <view class="exp-plan" wx:if="{{charPlanView.length}}">
        <view class="exp-plan-row" wx:for="{{charPlanView}}" wx:key="index">
          <text>{{item.name}} · Lv {{item.fromLevel}} → Lv {{item.toLevel}} · 需 {{item.expText}}{{item.starText}}</text>
          <view class="exp-row-del" data-index="{{index}}" bindtap="onRemoveChar">×</view>
        </view>
        <view class="exp-sum">已保留 {{charPlanView.length}} 个角色 · 合计需要 {{exp.planNeedText}} · {{exp.planDiffText}}</view>
      </view>
    </view>

    <view class="exp-card">
      <view class="exp-card-title">圣遗物经验</view>
      <view class="exp-total">合计经验 {{exp.artTotalText}}</view>
      <view class="exp-result">可升满 <text class="exp-strong">{{exp.artCount}}</text> 个五星圣遗物（+0 → +20） · 剩余 {{exp.artRestText}} 经验</view>
      <view class="exp-note">{{exp.artNote}}</view>
    </view>

    <view class="foot-tip">经验书 20,000 / 5,000 / 1,000；祝圣油膏 2,500、祝圣精华 10,000。</view>
  </view>

  <view class="panel">
    <view class="panel-title">抽数换算</view>
    <view class="panel-desc">常驻池抽数（{{g.fateStandard}}）不计入货币折算与合计可抽。</view>

    <view class="convert-item">
      <view class="convert-line">
        <text class="convert-label">每日积累</text>
        <text class="convert-value">+{{res.dailyPrimogemsText}} {{g.currency}}/天</text>
      </view>
      <view class="convert-note">≈ {{res.dailyPulls}} 抽/天 · 每天自动计入资源</view>
    </view>

    <view class="convert-item">
      <view class="convert-line">
        <text class="convert-label">{{g.currency}}可兑换</text>
        <text class="convert-value">{{res.pullsFromPrimogemsText}} 抽</text>
      </view>
      <view class="convert-note">余 {{res.primogemsRemainderText}} {{g.currency}} · 1 抽 = {{res.primogemsPerPull}} {{g.currency}}</view>
    </view>

    <view class="convert-item">
      <view class="convert-line">
        <text class="convert-label">限定抽数折算</text>
        <text class="convert-value">{{res.primogemsFromFatesText}} {{g.currency}}</text>
      </view>
      <view class="convert-note">{{g.fateLimited}} × {{res.primogemsPerPull}}</view>
    </view>

    <view class="convert-item highlight">
      <view class="convert-line">
        <text class="convert-label">合计可抽</text>
        <text class="convert-value">{{res.totalPullsText}} 抽</text>
      </view>
      <view class="convert-note">货币 + 限定抽数折算 {{res.totalPrimogemsText}} {{g.currency}}</view>
    </view>
  </view>

  <view class="panel">
    <view class="panel-title">数据存在哪</view>
    <view class="panel-desc">离线版不连接服务器，所有记录与资源都保存在本机小程序缓存中（按原神 / 星穹铁道分开存放）。</view>
    <view class="foot-tip">1. 卸载小程序、清理微信缓存或更换手机，数据不会自动同步，建议定期在「统计」页导出备份。</view>
    <view class="foot-tip">2. 网页版数据存在电脑服务端的 H2 数据库，与小程序缓存互不相通，可导出 JSON 备份后在小程序里导入。</view>
    <view class="foot-tip">3. 离线版暂不支持截图识别，可直接手动录入，或在「抽卡」页用「链接导入」读取米游社抽卡记录。</view>
  </view>
</view>

<name-picker visible="{{pickerVisible}}" game="{{game}}" current="{{selectedChar}}" names="{{charNames}}"
  showTabs="{{false}}" excludeProtagonist="{{true}}" bind:select="onPickChar" bind:close="onClosePicker"/>

<view wx:if="{{editing}}" class="mask" bindtap="closeEdit">
  <view class="modal" catchtap="noop">
    <view class="modal-head">
      <text class="modal-title">编辑资源 · {{g.fullName}}</text>
      <view class="modal-close" bindtap="closeEdit">×</view>
    </view>
    <scroll-view class="modal-body" scroll-y="true" style="height:60vh; padding-bottom:16rpx;">
      <view class="form-row">
        <text class="form-label">{{g.currency}}</text>
        <input class="form-input" type="number" value="{{form.primogems}}" data-key="primogems" bindinput="onInput" placeholder="0"/>
      </view>
      <view class="form-row">
        <text class="form-label">{{g.credit}}</text>
        <input class="form-input" type="number" value="{{form.mora}}" data-key="mora" bindinput="onInput" placeholder="0"/>
      </view>
      <view class="form-row">
        <text class="form-label">{{g.fateLimited}}</text>
        <input class="form-input" type="number" value="{{form.intertwinedFates}}" data-key="intertwinedFates" bindinput="onInput" placeholder="0"/>
      </view>
      <view class="form-row">
        <text class="form-label">{{g.fateStandard}}</text>
        <input class="form-input" type="number" value="{{form.acquaintedFates}}" data-key="acquaintedFates" bindinput="onInput" placeholder="0"/>
      </view>
      <view class="form-row">
        <text class="form-label">每天自动增加 {{g.currency}}</text>
        <input class="form-input" type="number" value="{{form.dailyPrimogems}}" data-key="dailyPrimogems" bindinput="onInput" placeholder="0"/>
      </view>
      <block wx:if="{{game === 'genshin'}}">
        <view class="form-row">
          <text class="form-label">大英雄的经验（本）</text>
          <input class="form-input" type="number" value="{{form.heroWit}}" data-key="heroWit" bindinput="onInput" placeholder="0"/>
        </view>
        <view class="form-row">
          <text class="form-label">冒险家的经验（本）</text>
          <input class="form-input" type="number" value="{{form.adventurerExp}}" data-key="adventurerExp" bindinput="onInput" placeholder="0"/>
        </view>
        <view class="form-row">
          <text class="form-label">流浪者的经验（本）</text>
          <input class="form-input" type="number" value="{{form.wandererAdvice}}" data-key="wandererAdvice" bindinput="onInput" placeholder="0"/>
        </view>
        <view class="form-row">
          <text class="form-label">祝圣油膏（个）</text>
          <input class="form-input" type="number" value="{{form.sanctifyingUnction}}" data-key="sanctifyingUnction" bindinput="onInput" placeholder="0"/>
        </view>
        <view class="form-row">
          <text class="form-label">祝圣精华（个）</text>
          <input class="form-input" type="number" value="{{form.sanctifyingEssence}}" data-key="sanctifyingEssence" bindinput="onInput" placeholder="0"/>
        </view>
      </block>
      <view class="foot-tip">每日额度按自然日自动累加到资源，修改资产或额度后从当天重新计；留空按 0 处理。</view>
    </scroll-view>
    <view class="modal-foot">
      <view class="btn btn-text" bindtap="closeEdit">取消</view>
      <view class="btn btn-primary" bindtap="saveEdit">保存</view>
    </view>
  </view>
</view>

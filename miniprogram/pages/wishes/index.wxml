<view class="page">
  <view class="topbar" style="padding-top: {{statusBarHeight + 36}}px">
    <view class="brand">
      <view class="brand-mark">SA</view>
      <view class="brand-name">SouthAir Genshin</view>
    </view>
    <game-switch game="{{game}}" bind:change="onSwitchGame" />
  </view>

  <view class="section-head">
    <view>
      <view class="section-title">抽卡记录</view>
      <view class="section-sub">五星出货记录 · 记录抽到五星用了多少抽 · 支持链接导入</view>
    </view>
  </view>

  <view class="toolbar">
    <picker class="pool-picker" range="{{poolOptions}}" value="{{poolIndex}}" bindchange="onPoolChange">
      <view class="pool-picker-box">{{poolOptions[poolIndex]}} ▾</view>
    </picker>
    <view class="filter-toggle {{onlyFive ? 'active' : ''}}" bindtap="toggleOnlyFive">只看五星</view>
    <view class="toolbar-title">共 {{total}} 条</view>
  </view>

  <view class="wish-filters">
    <picker class="pool-picker" range="{{uidOptions}}" value="{{uidIndex}}" bindchange="onUidChange">
      <view class="pool-picker-box">{{uidOptions[uidIndex]}} ▾</view>
    </picker>
    <input class="wish-search" type="text" value="{{keyword}}" placeholder="搜索名称"
           bindinput="onKeywordInput"/>
    <picker mode="date" value="{{startDate}}" bindchange="onStartDate">
      <view class="pool-picker-box">{{startDate || '开始日期'}} ▾</view>
    </picker>
    <picker mode="date" value="{{endDate}}" bindchange="onEndDate">
      <view class="pool-picker-box">{{endDate || '结束日期'}} ▾</view>
    </picker>
    <view class="filter-toggle" bindtap="resetFilters">重置筛选</view>
    <view class="filter-toggle" bindtap="runHealth">数据体检</view>
  </view>

  <view class="btn-row">
    <view class="btn btn-primary btn-sm" bindtap="openAdd">录入五星</view>
    <view class="btn btn-text btn-sm {{rows.length ? '' : 'disabled'}}" bindtap="toggleAll">{{allChecked ? '取消全选' : '全选本页'}}</view>
    <view class="btn btn-outline btn-sm {{rows.length ? '' : 'disabled'}}" bindtap="openBatchEdit">批量编辑本页</view>
    <view class="btn btn-danger btn-sm {{selectedCount ? '' : 'disabled'}}" bindtap="deleteSelected">批量删除{{selectedCount ? '（' + selectedCount + '）' : ''}}</view>
    <view class="btn btn-outline btn-sm" bindtap="openLinkImport">链接导入</view>
  </view>

  <block wx:if="{{rows.length}}">
    <view class="record rarity-{{item.rarity}}" wx:for="{{rows}}" wx:key="id">
      <view class="record-top">
        <view class="check {{item.checked ? 'on' : ''}}" data-id="{{item.id}}" bindtap="toggleSelect">{{item.checked ? '✓' : ''}}</view>
        <view class="record-avatar">
          <text>{{item.initial}}</text>
          <image wx:if="{{item.icon}}" src="{{item.icon}}" mode="aspectFill" data-id="{{item.id}}" binderror="onAvatarError"/>
        </view>
        <view class="record-info">
          <view class="record-line">
            <text class="record-name {{item.rarity === 3 ? 'muted' : ''}}">{{item.displayName}}</text>
            <text class="stars">{{item.stars}}</text>
          </view>
          <view class="record-meta">
            <text>{{item.itemType}}</text>
            <text wx:if="{{item.uid}}" class="uid-pill">UID {{item.uid}}</text>
            <text wx:if="{{item.rarity === 5}}" class="{{item.isUp ? 'up-text' : 'lost-text'}}">{{item.isUp ? 'UP 内' : '未中 UP'}}</text>
            <text wx:if="{{item.rarity === 5}}">用了 {{item.pityCount}} 抽</text>
            <text wx:if="{{item.rarity === 5 && item.capture}}" class="capture">捕获明光</text>
            <text class="record-time">{{item.time}}</text>
          </view>
        </view>
        <text class="pool-tag {{item.isUp ? 'up' : ''}}">{{item.pool}}</text>
      </view>

      <view class="record-bottom">
        <text class="record-id">#{{item.id}}</text>
        <view class="record-actions">
          <text class="link" data-id="{{item.id}}" bindtap="editRow">编辑</text>
          <text class="link danger" data-id="{{item.id}}" bindtap="removeRow">删除</text>
        </view>
      </view>
    </view>
  </block>

  <view wx:if="{{!rows.length}}" class="panel">
    <view class="empty">暂无抽卡记录，点击「录入五星」开始记录</view>
  </view>

  <view class="pager" wx:if="{{total > 0}}">
    <view class="btn btn-text btn-sm {{page <= 1 ? 'disabled' : ''}}" bindtap="prevPage">上一页</view>
    <text class="pager-info">第 {{page}} / {{pages}} 页 · 共 {{total}} 条</text>
    <view class="btn btn-text btn-sm {{page >= pages ? 'disabled' : ''}}" bindtap="nextPage">下一页</view>
  </view>

  <view class="foot-tip">每页 10 条；勾选仅对当前页有效，翻页 / 切卡池 / 切游戏会自动清空。只记录四星角色与五星物品，导入合并时按「UID + 名称 + 卡池 + 时间」去重。</view>
</view>

<!-- 单条编辑 -->
<view wx:if="{{editorVisible}}" class="mask" bindtap="closeEditor">
  <view class="modal" catchtap="noop">
    <view class="modal-head">
      <text class="modal-title">{{editorId ? '编辑抽卡' : '录入五星'}} · {{g.fullName}}</text>
      <view class="modal-close" bindtap="closeEditor">×</view>
    </view>
    <scroll-view scroll-y class="modal-body">
      <view class="form-row">
        <text class="form-label">选择角色 / 物品</text>
        <view class="form-picker" bindtap="openNamePicker">
          <view class="name-field {{editor.itemName ? '' : 'placeholder'}}">
            <view wx:if="{{editor.icon}}" class="name-field-icon">
              <image src="{{editor.icon}}" mode="aspectFill"/>
            </view>
            <text class="name-field-text">{{editor.itemName || '请选择角色 / 物品'}}</text>
            <text class="name-field-arrow">›</text>
          </view>
        </view>
      </view>
      <view class="form-row">
        <text class="form-label">卡池</text>
        <picker class="form-picker" range="{{poolLabels}}" value="{{editor.poolIndex}}" bindchange="onEditorPool">
          <view class="picker-box">{{poolLabels[editor.poolIndex]}}</view>
        </picker>
      </view>
      <view class="form-row" wx:if="{{game === 'genshin'}}">
        <text class="form-label">触发捕获明光</text>
        <switch class="switch" color="#d3bc8e" checked="{{editor.capture}}" bindchange="onEditorCapture"/>
      </view>
      <view class="form-row">
        <text class="form-label">抽到五星用了多少抽</text>
        <input class="form-input" type="number" value="{{editor.pity}}" bindinput="onEditorPity" placeholder="1"/>
      </view>
      <view class="form-row">
        <text class="form-label">抽卡时间</text>
        <view class="form-datetime">
          <picker mode="date" value="{{editor.date}}" bindchange="onEditorDate">
            <view class="picker-box">{{editor.date}}</view>
          </picker>
          <picker mode="time" value="{{editor.time}}" bindchange="onEditorTime">
            <view class="picker-box picker-time">{{editor.time}}</view>
          </picker>
        </view>
      </view>
      <view class="foot-tip">类型与是否 UP 会根据名称和卡池自动识别；只记录四星角色与五星物品，三星物品、四星武器 / 光锥不记录。</view>
    </scroll-view>
    <view class="modal-foot">
      <view class="btn btn-text" bindtap="closeEditor">取消</view>
      <view class="btn btn-primary" bindtap="saveEditor">保存</view>
    </view>
  </view>
</view>

<!-- 批量编辑本页 -->
<view wx:if="{{batchVisible}}" class="mask" bindtap="closeBatchEdit">
  <view class="modal" catchtap="noop">
    <view class="modal-head">
      <text class="modal-title">批量编辑本页 · {{g.fullName}}</text>
      <view class="modal-close" bindtap="closeBatchEdit">×</view>
    </view>
    <scroll-view scroll-y class="modal-body">
      <view class="batch-edit-row" wx:for="{{batchRows}}" wx:key="id">
        <text class="batch-edit-index">{{item.index}}</text>
        <input class="form-input batch-edit-name" value="{{item.name}}" data-index="{{index}}"
               bindinput="onBatchName" placeholder="名称"/>
        <input class="form-input batch-edit-pity" type="number" value="{{item.pityCount}}"
               data-index="{{index}}" bindinput="onBatchPity" placeholder="抽数"/>
        <switch class="switch" color="#d3bc8e" checked="{{item.isUp}}"
                data-index="{{index}}" bindchange="onBatchUp"/>
      </view>
      <view class="foot-tip">可修改名称 / 抽数 / 是否 UP；星级、卡池与类型保持不变。</view>
    </scroll-view>
    <view class="modal-foot">
      <view class="btn btn-text" bindtap="closeBatchEdit">取消</view>
      <view class="btn btn-primary" bindtap="saveBatchEdit">保存修改</view>
    </view>
  </view>
</view>

<!-- 链接导入：云函数下载抽卡记录 JSON / CSV -->
<view wx:if="{{linkVisible}}" class="mask" bindtap="closeLinkImport">
  <view class="modal" catchtap="noop">
    <view class="modal-head">
      <text class="modal-title">链接导入 · {{g.fullName}}</text>
      <view class="modal-close" bindtap="closeLinkImport">×</view>
    </view>
    <view class="modal-body" style="height:auto; padding-bottom:16rpx;">
      <view class="text-tip">粘贴米游社抽卡记录链接，或抽卡记录 JSON / CSV 的公网直链、云存储文件 ID：</view>
      <input class="link-input" value="{{linkUrl}}" bindinput="onLinkInput" maxlength="-1"
             placeholder="米游社抽卡记录链接 / https://example.com/southair-wishes.json"/>
      <view class="foot-tip">米游社链接会自动读取全部卡池并推算保底、判定 UP；文件链接支持 JSON / CSV 与 cloud://。链接含账号凭证，请勿分享。</view>
    </view>
    <view class="modal-foot">
      <view class="btn btn-text" bindtap="closeLinkImport">取消</view>
      <view class="btn btn-primary" bindtap="applyLinkImport">下载并导入</view>
    </view>
  </view>
</view>

<name-picker visible="{{pickerVisible}}" game="{{game}}" current="{{editor.itemName}}"
             exclude-protagonist="{{true}}"
             bind:select="onEditorName" bind:close="closeNamePicker" />

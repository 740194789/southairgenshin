.pool-picker-box {
  padding: 10rpx 20rpx;
  border: 1rpx solid rgba(211, 188, 142, 0.32);
  border-radius: 12rpx;
  color: #d3bc8e;
  font-size: 24rpx;
  background: rgba(211, 188, 142, 0.06);
}

.toolbar-title {
  margin: 0 0 0 16rpx;
  flex: none;
  font-size: 24rpx;
  color: #8b90a6;
}

.btn-row {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 16rpx;
}

.wish-pity {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 16rpx;
}

.wish-pity-chip {
  margin: 0 12rpx 12rpx 0;
  padding: 10rpx 18rpx;
  border-radius: 16rpx;
  border: 1rpx solid rgba(211, 188, 142, 0.24);
  background: linear-gradient(150deg, rgba(30, 35, 55, 0.78), rgba(12, 15, 24, 0.86));
  color: #8b90a6;
  font-size: 22rpx;
  line-height: 1.4;
}

.wish-pity-chip.guaranteed {
  border-color: rgba(211, 188, 142, 0.5);
  color: #d3bc8e;
  background: linear-gradient(150deg, rgba(211, 188, 142, 0.16), rgba(12, 15, 24, 0.86));
}

.wish-pity-manual {
  margin-left: 8rpx;
  padding: 0 8rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(211, 188, 142, 0.45);
  color: #d3bc8e;
  font-size: 18rpx;
}

.btn-row .btn {
  margin: 0 12rpx 12rpx 0;
}

.filter-toggle {
  margin-left: 16rpx;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(211, 188, 142, 0.24);
  color: #8b90a6;
  font-size: 22rpx;
  line-height: 1.3;
}

.filter-toggle.active {
  border-color: rgba(211, 188, 142, 0.65);
  background: rgba(211, 188, 142, 0.12);
  color: #f2e2bd;
}

.record {
  position: relative;
  background: linear-gradient(160deg, rgba(30, 35, 55, 0.92), #141826);
  border: 1rpx solid rgba(211, 188, 142, 0.16);
  border-radius: 20rpx;
  padding: 22rpx 24rpx 16rpx 28rpx;
  margin-bottom: 16rpx;
  overflow: hidden;
}

.record::before {
  content: "";
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 6rpx;
  background: rgba(211, 188, 142, 0.3);
}

.record.rarity-5 {
  background:
    radial-gradient(520rpx 200rpx at 100% -30%, rgba(211, 188, 142, 0.16), transparent 70%),
    linear-gradient(160deg, rgba(34, 39, 61, 0.94), #151928);
  border-color: rgba(211, 188, 142, 0.28);
}

.record.rarity-5::before {
  background: linear-gradient(180deg, #f2e2bd, #b9944f);
}

.record.rarity-4::before {
  background: linear-gradient(180deg, #c9adff, #8065c7);
}

.record-top {
  display: flex;
  align-items: center;
}

.check {
  width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  border-radius: 50%;
  border: 1rpx solid rgba(211, 188, 142, 0.42);
  color: #1b1a16;
  font-size: 20rpx;
  margin-right: 14rpx;
  flex-shrink: 0;
}

.check.on {
  background: #d3bc8e;
  border-color: #d3bc8e;
}

.record-avatar {
  position: relative;
  flex-shrink: 0;
  width: 64rpx;
  height: 64rpx;
  line-height: 64rpx;
  margin-right: 16rpx;
  border-radius: 50%;
  overflow: hidden;
  text-align: center;
  font-size: 26rpx;
  font-weight: 600;
  color: #f2e2bd;
  background: linear-gradient(135deg, rgba(211, 188, 142, 0.28), rgba(90, 120, 255, 0.16));
  border: 1rpx solid rgba(211, 188, 142, 0.24);
}

.record-avatar image {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.record.rarity-4 .record-avatar {
  color: #ddceff;
  background: linear-gradient(135deg, rgba(154, 120, 224, 0.36), rgba(90, 120, 255, 0.16));
  border-color: rgba(183, 156, 255, 0.36);
}

.record-info {
  flex: 1;
  min-width: 0;
}

.record-line {
  display: flex;
  align-items: center;
}

.record-name {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 600;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.record-name.muted {
  color: #8b90a6;
  font-weight: 400;
}

.record-line .stars {
  flex-shrink: 0;
  margin-left: 8rpx;
  font-size: 22rpx;
}

.record-top .pool-tag {
  flex-shrink: 0;
  margin-left: 12rpx;
}

.record-meta {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  font-size: 21rpx;
  color: #8b90a6;
  margin-top: 6rpx;
}

.record-meta > text {
  margin-right: 14rpx;
}

.record-meta .record-time {
  margin-right: 0;
}

.up-text,
.lost-text,
.capture {
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(211, 188, 142, 0.16);
  line-height: 1.5;
}

.up-text {
  color: #86e0af;
  border-color: rgba(125, 211, 160, 0.34);
  background: rgba(125, 211, 160, 0.1);
}

.lost-text {
  color: #ff9c9c;
  border-color: rgba(255, 143, 143, 0.32);
  background: rgba(255, 143, 143, 0.1);
}

.capture {
  color: #7ad7c0;
  border-color: rgba(122, 215, 192, 0.32);
  background: rgba(122, 215, 192, 0.1);
}

.record-time {
  color: #a9adc0;
}

.record-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 14rpx;
  padding-top: 12rpx;
  border-top: 1rpx dashed rgba(255, 255, 255, 0.07);
}

.record-id {
  font-size: 20rpx;
  color: #6f7488;
}

.record-actions .link {
  font-size: 24rpx;
  color: #d3bc8e;
  margin-left: 28rpx;
}

.record-actions .link.danger {
  color: #ff6b6b;
}

.record-actions .link:active {
  opacity: 0.7;
}

.pager {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 12rpx 0;
}

.pager-info {
  font-size: 24rpx;
  color: #8b90a6;
  margin: 0 20rpx;
}

.form-picker {
  flex: 1;
  text-align: right;
}

/* 名称触发器：小头像 + 名字 + 箭头 */
.name-field {
  display: inline-flex;
  align-items: center;
  justify-content: flex-end;
  max-width: 100%;
}

.name-field-icon {
  position: relative;
  flex-shrink: 0;
  width: 40rpx;
  height: 40rpx;
  margin-right: 10rpx;
  border-radius: 8rpx;
  overflow: hidden;
  background: rgba(211, 188, 142, 0.12);
  border: 1rpx solid rgba(211, 188, 142, 0.24);
}

.name-field-icon image {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.name-field-text {
  max-width: 300rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: 26rpx;
  color: #f2e2bd;
}

.name-field.placeholder .name-field-text {
  color: #8b90a6;
}

.name-field-arrow {
  margin-left: 8rpx;
  font-size: 24rpx;
  color: #8b90a6;
}

.form-datetime {
  display: flex;
  align-items: center;
  flex: 1;
  justify-content: flex-end;
}

.picker-time {
  margin-left: 16rpx;
}

/* 筛选行：名称 / 日期 / 重置 / 体检 */

.wish-filters {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  margin: 0 0 16rpx;
  padding: 16rpx;
  border: 1rpx solid rgba(211, 188, 142, 0.16);
  border-radius: 16rpx;
  background: linear-gradient(160deg, rgba(30, 35, 55, 0.72), rgba(13, 16, 26, 0.78));
}

.wish-filters .pool-picker,
.wish-filters .filter-toggle {
  margin: 0 12rpx 12rpx 0;
}

.wish-search {
  height: 56rpx;
  margin: 0 12rpx 12rpx 0;
  padding: 0 18rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 12rpx;
  background: rgba(9, 11, 20, 0.72);
  color: #ecebe7;
  font-size: 24rpx;
  line-height: 56rpx;
  width: 190rpx;
}


/* 批量编辑本页 */
.batch-edit-row {
  display: flex;
  align-items: center;
  margin-bottom: 14rpx;
}

.batch-edit-index {
  flex: 0 0 44rpx;
  font-size: 22rpx;
  color: #71778e;
}

.batch-edit-name {
  flex: 1;
  margin-right: 12rpx;
}

.batch-edit-pity {
  flex: 0 0 120rpx;
  margin-right: 12rpx;
}

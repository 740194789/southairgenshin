.hero {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 28rpx;
  border-radius: 24rpx;
  margin-bottom: 24rpx;
  background:
    radial-gradient(520rpx 260rpx at 8% -20%, rgba(211, 188, 142, 0.22), transparent 62%),
    #171b2b;
  border: 1rpx solid rgba(211, 188, 142, 0.32);
}

.hero-main {
  flex: 1;
  min-width: 0;
}

.hero-sub {
  font-size: 22rpx;
  letter-spacing: 2rpx;
  color: #8b90a6;
  text-transform: uppercase;
}

.hero-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #f2e2bd;
  margin: 4rpx 0 8rpx;
}

.hero-desc {
  font-size: 24rpx;
  color: #a9adc0;
}

.strong {
  color: #ffd479;
  font-weight: 600;
}

.hero-badge {
  flex-shrink: 0;
  margin-left: 16rpx;
  text-align: center;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  border: 1rpx solid rgba(211, 188, 142, 0.32);
  background: rgba(211, 188, 142, 0.08);
}

.hero-badge-label {
  font-size: 22rpx;
  color: #8b90a6;
}

.hero-badge-value {
  font-size: 36rpx;
  font-weight: 700;
  color: #f2e2bd;
}

.inline {
  margin-left: 12rpx;
  font-size: 22rpx;
}

.pity-line {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  font-size: 24rpx;
  color: #c8ccdb;
  margin-bottom: 10rpx;
}

.pity-note {
  font-size: 22rpx;
  color: #8b90a6;
  line-height: 1.65;
  margin-top: 6rpx;
}

.pool-stat {
  padding: 18rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.06);
}

.pool-stat:last-child {
  border-bottom: 0;
  padding-bottom: 4rpx;
}

.pool-stat-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.pool-pity {
  font-size: 24rpx;
  color: #c8ccdb;
}

.pool-meta {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  font-size: 22rpx;
  color: #8b90a6;
}

.pool-meta text {
  margin-right: 20rpx;
}

.bar-row {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
}

.bar-name {
  width: 150rpx;
  font-size: 24rpx;
  color: #c8ccdb;
  flex-shrink: 0;
}

.bar-track {
  flex: 1;
  height: 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.08);
  overflow: hidden;
  margin: 0 16rpx;
}

.bar-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #9f8b5f, #f2e2bd);
}

.bar-count {
  width: 70rpx;
  text-align: right;
  font-size: 24rpx;
  color: #f2e2bd;
  flex-shrink: 0;
}

.recent-name {
  font-size: 26rpx;
  color: #ecebe7;
}

.recent-time {
  font-size: 22rpx;
  color: #8b90a6;
}

/* ---------- 五星抽数柱形图 ---------- */

.pull-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.pull-toggle {
  font-size: 20rpx;
  color: #c8ccdb;
  border: 1rpx solid rgba(211, 188, 142, 0.4);
  border-radius: 999rpx;
  padding: 6rpx 18rpx;
}

.pull-toggle.active {
  color: #ffd479;
  border-color: rgba(255, 212, 121, 0.7);
}

.pull-summary {
  font-size: 22rpx;
  color: #8b90a6;
  line-height: 1.6;
  margin-bottom: 16rpx;
}

.pull-scroll {
  width: 100%;
  white-space: nowrap;
}

.pull-chart {
  display: flex;
  align-items: flex-end;
  padding: 0 4rpx;
}

.pull-col {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  width: 64rpx;
  flex-shrink: 0;
}

.pull-val {
  height: 26rpx;
  line-height: 26rpx;
  font-size: 18rpx;
  color: #f2e2bd;
}

.pull-bar {
  width: 28rpx;
  border-radius: 8rpx 8rpx 2rpx 2rpx;
  background: linear-gradient(180deg, #f2e2bd, #9f8b5f);
}

.pull-col.lost .pull-bar {
  background: linear-gradient(180deg, #6b7185, #444a5e);
}

.pull-name {
  width: 60rpx;
  height: 84rpx;
  overflow: hidden;
  margin-top: 8rpx;
  font-size: 18rpx;
  line-height: 1.2;
  color: #8b90a6;
  text-align: center;
  word-break: break-all;
}

/* ---------- 抽卡期望 ---------- */
.expect-modes {
  display: flex;
  margin-top: 18rpx;
}

.expect-mode + .expect-mode {
  margin-left: 12rpx;
}

.expect-mode {
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(211, 188, 142, 0.28);
  font-size: 22rpx;
  color: #8b90a6;
}

.expect-mode.is-on {
  background: rgba(211, 188, 142, 0.16);
  border-color: rgba(211, 188, 142, 0.6);
  color: #d3bc8e;
}

.expect-mode.is-disabled {
  opacity: 0.4;
}

.expect-targets {
  display: flex;
  margin-top: 20rpx;
}

.expect-target + .expect-target {
  margin-left: 18rpx;
}

.expect-target {
  flex: 1;
  padding: 16rpx 18rpx;
  border-radius: 16rpx;
  background: #171b2b;
  border: 1rpx solid rgba(211, 188, 142, 0.12);
}

.expect-target-label {
  font-size: 20rpx;
  color: #8b90a6;
}

.expect-stepper {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 12rpx 0 8rpx;
}

.expect-step {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #1e2437;
  color: #d3bc8e;
  font-size: 30rpx;
  line-height: 56rpx;
  text-align: center;
}

.expect-step.is-disabled {
  opacity: 0.35;
}

.expect-step-value {
  font-size: 30rpx;
  font-weight: 600;
  color: #ecebe7;
}

.expect-unit {
  margin-left: 4rpx;
  font-size: 20rpx;
  color: #8b90a6;
}

.expect-target-note {
  font-size: 20rpx;
  color: #8b90a6;
}

.expect-readout {
  margin-top: 20rpx;
  padding: 20rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, rgba(211, 188, 142, 0.14), rgba(211, 188, 142, 0.03));
  border: 1rpx solid rgba(211, 188, 142, 0.26);
}

.expect-kicker {
  font-size: 22rpx;
  color: #8b90a6;
}

.expect-number {
  margin: 8rpx 0 4rpx;
  font-size: 52rpx;
  font-weight: 700;
  line-height: 1.1;
  color: #d3bc8e;
}

.expect-number .expect-unit {
  margin-left: 8rpx;
  font-size: 24rpx;
  font-weight: 400;
}

.expect-compare {
  font-size: 22rpx;
  line-height: 1.6;
  color: #c3c7d8;
}

.expect-bar {
  height: 10rpx;
  margin-top: 14rpx;
  border-radius: 999rpx;
  background: #232838;
  overflow: hidden;
}

.expect-bar-fill {
  height: 100%;
  border-radius: 999rpx;
  background: #d3bc8e;
}

.expect-bar-fill.done {
  background: #7dd3a0;
}

.expect-split {
  display: flex;
  margin-top: 16rpx;
}

.expect-part + .expect-part {
  margin-left: 18rpx;
}

.expect-part {
  flex: 1;
  padding: 16rpx;
  border-radius: 14rpx;
  background: #171b2b;
  border: 1rpx solid rgba(211, 188, 142, 0.12);
}

.expect-part-label {
  font-size: 20rpx;
  color: #8b90a6;
}

.expect-part-value {
  margin: 4rpx 0;
  font-size: 30rpx;
  font-weight: 600;
  color: #ecebe7;
}

.expect-part-note {
  font-size: 20rpx;
  color: #8b90a6;
}

.expect-note {
  margin-top: 12rpx;
  font-size: 20rpx;
  line-height: 1.6;
  color: #8b90a6;
}
